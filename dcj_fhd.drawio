        <mxCell id="node_DCJ-03-03-02" value="&lt;b&gt;DCJ-03-03-02  Multi-Name, Identity Instrument &amp;amp; GNAF Spatial Store [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Maintains dcj_tdm.person_name (1,623), person_identity_instrument (1,517), address_location (260), and address_relation (630).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996" y="826" width="376" height="72" as="geometry"/></mxCell>
