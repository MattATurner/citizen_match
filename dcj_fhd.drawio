        <mxCell id="node_DCJ-03-02" value="&lt;b&gt;DCJ-03-02  Golden Person Survivorship &amp;amp; Protection Rollup Engine [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Resolves golden demographic attributes (dcj_match.field_survivorship) and rolls up Domestic Violence/Child Safety flags.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="562" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-03" target="node_DCJ-03-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03-03" value="&lt;b&gt;DCJ-03-03  9-Table Target Data Model Persistence (dcj_tdm) [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Persists the 9 mastered Target Data Model tables in all-things-cdp.dcj_tdm with zero working-table clutter.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="650" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-03" target="node_DCJ-03-03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03-03-01" value="&lt;b&gt;DCJ-03-03-01  Core Party, Golden Person &amp;amp; Source Linkage Store [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Maintains dcj_tdm.party (681), dcj_tdm.person (599 golden rows), and dcj_tdm.person_source_linkage (1,150).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996" y="738" width="376" height="72" as="geometry"/></mxCell>
