        <mxCell id="node_DCJ-04-03" value="&lt;b&gt;DCJ-04-03  Conversational Analytics &amp;amp; Caseworker Graph Co-Pilot [◆] [AGENT]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Assists caseworkers with natural-language ISO GQL kinship queries grounded in BigQuery Knowledge Catalog.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1426" y="474" width="398" height="72" as="geometry"/></mxCell>
