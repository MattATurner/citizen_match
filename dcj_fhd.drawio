        <mxCell id="node_DCJ-04-02" value="&lt;b&gt;DCJ-04-02  BigQuery Knowledge Catalog Glossary &amp;amp; Lineage Sync [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Governs 6 categories, 118 Business Glossary terms &amp;amp; KPIs, and 118 Schema.&amp;lt;Column&amp;gt; EntryLinks in Knowledge Catalog.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1426" y="386" width="398" height="72" as="geometry"/></mxCell>
