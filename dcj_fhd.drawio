        <mxCell id="node_DCJ-03-03-03" value="&lt;b&gt;DCJ-03-03-03  Harmonised Kinship Relationship &amp;amp; Protection Event Store [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Maintains dcj_tdm.party_relationship (593 harmonised kinship/group edges) and person_protection_event (45 safety orders).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996" y="914" width="376" height="72" as="geometry"/></mxCell>
