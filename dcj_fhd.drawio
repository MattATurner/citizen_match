  <diagram id="fd-hierarchy" name="Functional Decomposition">
    <mxGraphModel dx="1872" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1872" pageHeight="1210" math="0" shadow="0">
