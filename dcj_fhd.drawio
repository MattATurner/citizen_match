        <mxCell id="node_DCJ-04-04" value="&lt;b&gt;DCJ-04-04  Caseworker 360 Graph Explorer &amp;amp; Scenario Scorecard UI [◆] [UI / HITL]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Visualizes multi-agency child/family graphs and tracks 3-method precision/recall (0.9970 F1) across all 8 scenarios.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1426" y="562" width="398" height="72" as="geometry"/></mxCell>
