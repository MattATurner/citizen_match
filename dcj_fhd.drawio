        <mxCell id="node_DCJ-04-01" value="&lt;b&gt;DCJ-04-01  Callable Real-Time Person Match TVF (fn_person_match) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Executes real-time hybrid lexical + BigQuery Vector Search + RRF intake lookup via dcj_match.fn_person_match.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1426" y="298" width="398" height="72" as="geometry"/></mxCell>
