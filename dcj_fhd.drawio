        <mxCell id="node_DCJ-03-04" value="&lt;b&gt;DCJ-03-04  Target BigQuery Property Graph (dcj_person_graph) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Exposes all-things-cdp.dcj_tdm.dcj_person_graph with 8 Node Labels and 9 Edge Labels for ISO GQL traversal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="1002" width="398" height="72" as="geometry"/></mxCell>
