        <mxCell id="node_DCJ-00" value="&lt;b&gt;DCJ-00  NSW DCJ Unified Person Data Model &amp;amp; Hybrid Match [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#CBD5E1&#x27;&gt;Unifies Child Protection, Family Preservation, and Youth Justice records into a 9-table Target Data Model and Property Graph.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="706" y="84" width="460" height="74" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01" value="&lt;b&gt;DCJ-01  Stage 1: Multi-Agency SDM Ingestion &amp;amp; Standardization [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Ingests ChildStory, InfoShare, and KIMS source records, standardizes keys, and builds the Bipartite Identifier Graph.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="210" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-00" target="node_DCJ-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-01" value="&lt;b&gt;DCJ-01-01  Multi-Agency SDM Ingestion &amp;amp; Schema Contract [INGEST]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Ingests raw person, household, address, and relationship feeds from ChildStory, InfoShare, and KIMS into dcj_sdm.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="298" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01" target="node_DCJ-01-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-01-01" value="&lt;b&gt;DCJ-01-01-01  ChildStory &amp;amp; KIMS Person-Address-Relationship Feed [◆] [INGEST]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Captures Child Protection and Youth Justice person profiles, aliases, CNI/NDIS IDs, addresses, and kinship links.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="386" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-01" target="node_DCJ-01-01-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-01-02" value="&lt;b&gt;DCJ-01-01-02  InfoShare Household Group &amp;amp; Client Intake Feed [◆] [INGEST]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Ingests Family Preservation client profiles, household group memberships (GRP-*), and service provider referrals.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="474" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-01" target="node_DCJ-01-01-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-02" value="&lt;b&gt;DCJ-01-02  Name, Phone, GNAF &amp;amp; SLK-581 Normalization Engine [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Normalizes diacritics, phonetic tokens, mobile numbers, GNAF PIDs, and AIHW SLK-581 linkage keys via SQL UDFs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="562" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01" target="node_DCJ-01-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-02-01" value="&lt;b&gt;DCJ-01-02-01  Diacritic, Phonetic &amp;amp; AIHW SLK-581 Key Generator [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Executes fold_diacritics, SOUNDEX, norm_phone, and compute_slk581 UDFs across all 1,150 source records.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="650" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-02" target="node_DCJ-01-02-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-02-02" value="&lt;b&gt;DCJ-01-02-02  NSW GNAF Address &amp;amp; Relationship Harmoniser [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Standardizes street suffixes, binds GNAF PIDs with lat/lon coordinates, and maps 78 relationship types into 5 categories.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="738" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-02" target="node_DCJ-01-02-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-03" value="&lt;b&gt;DCJ-01-03  Staged Source Profile Store (stg_source_profiles) [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Maintains the 1,150 unified source profiles and serialized natural-language match_key dossiers in dcj_match.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="826" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01" target="node_DCJ-01-03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-04" value="&lt;b&gt;DCJ-01-04  Bipartite Identifier Graph &amp;amp; Crisis Refuge Hub Guard [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Constructs the Bipartite Identifier Graph (has_identifier, identifier) with IDF rarity weights and hub suppression.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="914" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01" target="node_DCJ-01-04"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-04-01" value="&lt;b&gt;DCJ-01-04-01  Bipartite Identifier &amp;amp; IDF Rarity Calculator [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Extracts 5,143 profile-to-identifier edges and calculates LN(1 + N/df) rarity weights across 2,754 identifiers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="1002" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-04" target="node_DCJ-01-04-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-01-04-02" value="&lt;b&gt;DCJ-01-04-02  Crisis Refuge &amp;amp; Group Home Hub Suppressor (df &amp;gt; 5) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Flags shared crisis refuges and residential care homes (df &amp;gt; 5) with is_hub = TRUE to prevent hairball clusters.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="92" y="1090" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-01-04" target="node_DCJ-01-04-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02" value="&lt;b&gt;DCJ-02  Stage 2: Hybrid Retrieval, RRF Scoring &amp;amp; Gemini 3.5 Adjudication [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Combines BigQuery Vector Search, Reciprocal Rank Fusion (RRF), and the Gemini Platform AI Adjudicator (Gemini 3.5).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-00" target="node_DCJ-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-01" value="&lt;b&gt;DCJ-02-01  Autonomous Profile Embedding &amp;amp; BigQuery Vector Search [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Generates autonomous AI.EMBED vector embeddings (text-embedding-005) and executes native BigQuery VECTOR_SEARCH.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="522" y="298" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02" target="node_DCJ-02-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-01-01" value="&lt;b&gt;DCJ-02-01-01  Autonomous Dossier Embedding Generator (AI.EMBED) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Maintains 768-dimensional text-embedding-005 vectors on dcj_match.source_profile_search via GENERATED ALWAYS columns.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="544" y="386" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02-01" target="node_DCJ-02-01-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-01-02" value="&lt;b&gt;DCJ-02-01-02  Top-K Semantic Candidate Retriever (VECTOR_SEARCH) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Retrieves top-15 nearest neighbor profiles per record using native BigQuery VECTOR_SEARCH cosine similarity.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="544" y="474" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02-01" target="node_DCJ-02-01-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-02" value="&lt;b&gt;DCJ-02-02  Reciprocal Rank Fusion (RRF), Kinship &amp;amp; Twin Guard [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Fuses lexical IDF and vector rankings via RRF (k=60), adds 2-hop kinship boosts, and flags twin SLK-581 collisions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="522" y="562" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02" target="node_DCJ-02-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-02-01" value="&lt;b&gt;DCJ-02-02-01  Lexical + Semantic RRF Scorer (k = 60) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Combines non-hub bipartite IDF weights and BigQuery Vector Search ranks using Reciprocal Rank Fusion.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="544" y="650" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02-02" target="node_DCJ-02-02-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-02-02" value="&lt;b&gt;DCJ-02-02-02  2-Hop Kinship Boost &amp;amp; Twin SLK-581 Collision Guard [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Boosts pairs sharing a parent/carer or household group and diverts same-DOB twin SLK-581 collisions to GREY_ZONE.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="544" y="738" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02-02" target="node_DCJ-02-02-02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-03" value="&lt;b&gt;DCJ-02-03  Gemini Platform AI Adjudicator (gemini-3.5-flash) [◆] [AGENT]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Adjudicates 391 borderline GREY_ZONE pairs via AI.GENERATE on Gemini 3.5 with structured JSON verdicts and rationale.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="522" y="826" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02" target="node_DCJ-02-03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-04" value="&lt;b&gt;DCJ-02-04  Immutable AI Adjudication Audit Ledger [◆] [CRUD]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Records all Gemini 3.5 verdicts, confidence scores, prompt hashes, and steward overrides in person_match_adjudications.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="522" y="914" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02" target="node_DCJ-02-04"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-02-05" value="&lt;b&gt;DCJ-02-05  Data Steward Grey-Zone &amp;amp; Split/Merge Workbench [◆] [UI / HITL]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Provides Human-in-the-Loop review of Gemini 3.5 rationales, side-by-side source dossiers, and manual split/merge overrides.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="522" y="1002" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-02" target="node_DCJ-02-05"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03" value="&lt;b&gt;DCJ-03  Stage 3: Graph Clustering, Golden Survivorship &amp;amp; 9-Table TDM [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Clusters verified pairs via Two-Pass Connected Components and populates the pure 9-table Target Data Model and Property Graph.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="952" y="210" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-00" target="node_DCJ-03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03-01" value="&lt;b&gt;DCJ-03-01  Two-Pass Connected Components &amp;amp; Contradiction Pruning [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Executes iterative label propagation (sp_connected_components) in dcj_match with Pass-2 contradiction pruning.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="298" width="398" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-03" target="node_DCJ-03-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03-01-01" value="&lt;b&gt;DCJ-03-01-01  Pass-1 Graph Label Propagation (sp_connected_components) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Propagates minimum component_id labels across verified match edges until convergence in dcj_match.cc_pass1.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996" y="386" width="376" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="node_DCJ-03-01" target="node_DCJ-03-01-01"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="node_DCJ-03-01-02" value="&lt;b&gt;DCJ-03-01-02  Twin &amp;amp; Contradiction Edge Pruner (Pass-2 Re-Cluster) [◆] [BIZ FN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Detects internal NO_MATCH contradictions in cc_pass1, prunes weak bridges, and re-runs Pass-2 clustering into cc_final.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996" y="474" width="376" height="72" as="geometry"/></mxCell>
