        <mxCell id="node_DCJ-04" value="&lt;b&gt;DCJ-04  Stage 4: Real-Time Intake TVF, Knowledge Catalog &amp;amp; Caseworker 360 [DOMAIN]&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#475569&#x27;&gt;Serves real-time intake resolution via fn_person_match, governs 118 Knowledge Catalog terms, and powers Caseworker 360.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#F8FAFC;strokeColor=#1A73E8;fontColor=#0F172A;fontFamily=Inter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1404" y="210" width="420" height="72" as="geometry"/></mxCell>
