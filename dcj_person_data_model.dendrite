theme: "gcp-pro"
renderOrder: nodes-first
direction: right
spacing: 32

const GcpBlue = "#1a73e8"
const GcpGreen = "#1e8e3e"
const AmberGold = "#d97706"
const PurpleAccent = "#7c3aed"
const DarkSlate = "#202124"
const SubText = "#5f6368"
const CardBorder = "#dadce0"
const SurfaceWhite = "#ffffff"

Style @Ghost {
  fill: transparent, strokeWidth: 0, fontColor: transparent, padding: 0
}
Style @ArchitectureRoot {
  fill: "#f8fafd", strokeColor: "#c2d7f5", strokeWidth: 1.5, borderRadius: 16,
  padding: 24, gap: 24, fontColor: "#202124", fontSize: 22, labelWeight: bold,
  icon: "GoogleCloud", iconSize: 28
}
Style @SdmZone {
  fill: "#e8f0fe", strokeColor: "#8ab4f8", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @HybridZone {
  fill: "#e6f4ea", strokeColor: "#81c995", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @AdjudicatorZone {
  fill: "#fef7e0", strokeColor: "#fde293", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @TdmZone {
  fill: "#f3e8fd", strokeColor: "#c084fc", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @ProductCard {
  width: 220, height: 64,
  fill: $SurfaceWhite, strokeColor: $CardBorder, strokeWidth: 1, borderRadius: 8,
  fontColor: $DarkSlate, subFontColor: $SubText,
  fontSize: 14, subFontSize: 11.5, labelWeight: bold,
  textAlign: "left", textVAlign: "middle",
  iconPosition: "left", iconSize: 28, padding: 10, shadow: true
}
Style @HeroCard {
  base: @ProductCard,
  width: 220, height: 66, strokeColor: $GcpBlue, strokeWidth: 2,
  fontSize: 14, subFontSize: 11.5, iconSize: 30, padding: 10
}

Zone @GoogleCloud {
  title: "Google Cloud"
  subtitle: "NSW DCJ System Architecture: Source Systems to Unified Person View & Family Graph"
  style: @ArchitectureRoot
  layout: matrix
  cols: 4
  areas: ["sdm hybrid adjudicator tdm"]
  sizes: ["1fr", "1.05fr", "1.05fr", "1.1fr"]
  gap: 28

  Zone @Col1_SDM {
    area: "sdm"
    title: "1. Source Systems"
    subtitle: "dcj_sdm · 1,150 Source Records"
    style: @SdmZone
    layout: column, gap: 14, align: center, justify: center

    [sdm_cp: "Child Protection" | "ChildStory · 450 Records"] {
      style: @ProductCard, icon: "BigQuery",
      description: "Person records, 16 name types, 78 family relationship labels, and safety orders"
    }
    [sdm_fp: "Family Preservation" | "InfoShare · 380 Records"] {
      style: @ProductCard, icon: "BigQuery",
      description: "Partner intake records, preferred names, estimated birth years, and support groups"
    }
    [sdm_yj: "Youth Justice" | "Case System · 320 Records"] {
      style: @ProductCard, icon: "BigQuery",
      description: "Youth case records, street nicknames, spelling variations, and address mappings"
    }
    [sdm_gnaf: "NSW Street Addresses" | "260 Verified Locations"] {
      style: @ProductCard, icon: "MapsGeospatial",
      description: "Standardized NSW street addresses with map coordinates and crisis shelter flags"
    }
  }

  Zone @Col2_Hybrid {
    area: "hybrid"
    title: "2. Hybrid Person Match"
    subtitle: "dcj_match · Shared IDs + Vector Search"
    style: @HybridZone
    layout: column, gap: 18, align: center, justify: center

    [hyb_bip: "Shared ID & Shelter Filter" | "Weights Rare IDs · Flags Shelters"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Gives high weight to unique government IDs while flagging addresses shared by >5 people as crisis shelters"
    }
    [hyb_vec: "BigQuery Vector Search" | "Native AI.EMBED + VECTOR_SEARCH"] {
      style: @ProductCard, icon: "BigQuery",
      description: "BigQuery Vector Search finds matching people across nicknames, phonetic spelling variations, and surname changes"
    }
    [hyb_rrf: "Combined Match Scoring" | "IDs + Vector Rank + Family Ties"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Combines exact ID match, BigQuery Vector Search rank, and shared family members while preventing twin merges"
    }
  }

  Zone @Col3_Adjudicator {
    area: "adjudicator"
    title: "3. Gemini Platform Adjudicator"
    subtitle: "dcj_match · Gemini 3.5 + Audit Log"
    style: @AdjudicatorZone
    layout: column, gap: 18, align: center, justify: center

    [adj_cc: "Person Record Grouping" | "Links Matches · Separates Twins"] {
      style: @HeroCard, icon: "Dataflow",
      description: "Combines confirmed links into 600 Master Person profiles with zero false shelter or twin merges"
    }
    [adj_ledger: "Written Audit Log" | "Stores Every Decision & Reason"] {
      style: @ProductCard, icon: "CloudAuditLogs",
      description: "Permanent audit table recording the match decision, confidence score, and plain-English explanation"
    }
    [adj_llm: "Gemini Platform Adjudicator" | "Gemini 3.5 · 391 Borderline Pairs"] {
      style: @HeroCard, icon: "Gemini",
      description: "Calls Gemini 3.5 on Gemini Platform via BigQuery connection to adjudicate ambiguous pairs with written reasons"
    }
  }

  Zone @Col4_TDM {
    area: "tdm"
    title: "4. Unified View & Graph"
    subtitle: "dcj_tdm · 9 Target Tables + Graph"
    style: @TdmZone
    layout: column, gap: 18, align: center, justify: center

    [tdm_tables: "9 Master Person Tables" | "600 People · 100% Accuracy"] {
      style: @HeroCard, icon: "BigQuery",
      description: "One master profile per person plus full history of names, addresses, government IDs, family ties, and safety orders"
    }
    [tdm_graph: "Family Graph & Live Search" | "BigQuery Property Graph"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Connected family and audit graph plus real-time SQL search across ChildStory, InfoShare, and Youth Justice"
    }
    [tdm_catalog: "BigQuery Knowledge Catalog" | "118 Business Definitions"] {
      style: @ProductCard, icon: "Dataplex",
      description: "Plain-English business definitions and accuracy metrics linked directly to every table column"
    }
  }
}

[sdm_cp] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "ChildStory", color: $GcpBlue }
[sdm_fp] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "InfoShare", color: $GcpBlue }
[sdm_yj] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "Youth Justice", color: $GcpBlue }
[sdm_gnaf] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "NSW Addresses", color: $GcpBlue }

[hyb_bip] --> [hyb_vec] { sourceAnchor: "bottom", targetAnchor: "top", label: "1,150 Profiles", color: $GcpGreen }
[hyb_vec] --> [hyb_rrf] { sourceAnchor: "bottom", targetAnchor: "top", label: "Similar Names", color: $GcpGreen }

[hyb_rrf] --> [adj_llm] { sourceAnchor: "right", targetAnchor: "left", label: "391 Borderline", color: $AmberGold }
[hyb_rrf] --> [adj_cc] { sourceAnchor: "right", targetAnchor: "left", label: "405 Clear Links", color: $GcpGreen }

[adj_llm] --> [adj_ledger] { curve: "step",  sourceAnchor: "top", targetAnchor: "bottom", label: "Written Reasons", color: $AmberGold }
[adj_ledger] --> [adj_cc] { curve: "step",  sourceAnchor: "top", targetAnchor: "bottom", label: "Verified Links", color: $AmberGold }

[adj_cc] --> [tdm_tables] { sourceAnchor: "right", targetAnchor: "left", label: "600 People", color: $PurpleAccent }
[tdm_tables] --> [tdm_graph] { sourceAnchor: "bottom", targetAnchor: "top", label: "Family & ID Links", color: $PurpleAccent }
[tdm_graph] --> [tdm_catalog] { sourceAnchor: "bottom", targetAnchor: "top", label: "118 Definitions", color: $PurpleAccent }

animation "Main flow" {
  loop: false
  step 1: [sdm_cp] -> [hyb_bip] { packet: "1. Ingest Source Records", duration: "1.0s" }
  step 2: [hyb_bip] -> [hyb_vec] { packet: "2. AI Name & Profile Search", duration: "1.0s" }
  step 3: [hyb_vec] -> [hyb_rrf] { packet: "3. Combined Match Scoring", duration: "1.0s" }
  step 4: [hyb_rrf] -> [adj_llm] { packet: "4. Review 391 Borderline Pairs", duration: "1.0s" }
  step 5: [adj_llm] -> [adj_ledger] { packet: "5. Record Written Explanation", duration: "1.0s" }
  step 6: [adj_ledger] -> [adj_cc] { packet: "6. Group into Master People", duration: "1.0s" }
  step 7: [adj_cc] -> [tdm_tables] { packet: "7. Populate 9 Master Tables", duration: "1.0s" }
  step 8: [tdm_tables] -> [tdm_graph] { packet: "8. Build Family & Lineage Graph", duration: "1.0s" }
  step 9: [tdm_graph] -> [tdm_catalog] { packet: "9. Link 118 Business Definitions", duration: "1.0s" }
}
