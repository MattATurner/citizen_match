theme: "gcp-pro"
renderOrder: nodes-first
direction: right
spacing: 32

const GcpBlue = "#1a73e8"
const GcpGreen = "#1e8e3e"
const AmberGold = "#d97706"
const PurpleAccent = "#7c3aed"
const DarkSlate = "#202124"
const SubText = "#5f6368"
const CardBorder = "#dadce0"
const SurfaceWhite = "#ffffff"

Style @Ghost {
  fill: transparent, strokeWidth: 0, fontColor: transparent, padding: 0
}
Style @ArchitectureRoot {
  fill: "#f8fafd", strokeColor: "#c2d7f5", strokeWidth: 1.5, borderRadius: 16,
  padding: 24, gap: 24, fontColor: "#202124", fontSize: 22, labelWeight: bold,
  icon: "GoogleCloud", iconSize: 28
}
Style @SdmZone {
  fill: "#e8f0fe", strokeColor: "#8ab4f8", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @HybridZone {
  fill: "#e6f4ea", strokeColor: "#81c995", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @AdjudicatorZone {
  fill: "#fef7e0", strokeColor: "#fde293", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @TdmZone {
  fill: "#f3e8fd", strokeColor: "#c084fc", strokeWidth: 1.5, borderRadius: 12,
  padding: 16, gap: 14, fontColor: $DarkSlate, fontSize: 15, labelWeight: bold
}
Style @SubGroup {
  fill: "#ffffff", strokeColor: "#cbd5e1", strokeWidth: 1, borderRadius: 10,
  padding: 12, gap: 10, fontColor: $DarkSlate, fontSize: 13, labelWeight: bold
}
Style @ProductCard {
  width: 210, height: 60,
  fill: $SurfaceWhite, strokeColor: $CardBorder, strokeWidth: 1, borderRadius: 8,
  fontColor: $DarkSlate, subFontColor: $SubText,
  fontSize: 13.5, subFontSize: 11, labelWeight: bold,
  textAlign: "left", textVAlign: "middle",
  iconPosition: "left", iconSize: 28, padding: 10, shadow: true
}
Style @HeroCard {
  base: @ProductCard,
  width: 210, height: 64, strokeColor: $GcpBlue, strokeWidth: 2,
  fontSize: 14, subFontSize: 11, iconSize: 30, padding: 10
}

Zone @GoogleCloud {
  title: "Google Cloud"
  subtitle: "NSW DCJ Person Data Model (SDM to TDM), Hybrid Match & Property Graph"
  style: @ArchitectureRoot
  layout: matrix
  cols: 4
  areas: ["sdm hybrid adjudicator tdm"]
  sizes: ["1fr", "1.05fr", "1.05fr", "1.1fr"]
  gap: 28

  Zone @Col1_SDM {
    area: "sdm"
    title: "1. Source Data Model"
    subtitle: "dcj_sdm (14 Tables & Views)"
    style: @SdmZone
    layout: column, gap: 14, align: center, justify: center

    [sdm_cp: "Child Protection" | "ChildStory · 450 rows"] {
      style: @ProductCard, icon: "BigQuery",
      description: "person_file_1_ciw, person_names_file_2_ciw, person_relation_file_4_ciw, addr_loc_ods, addr_rel_loc_ods"
    }
    [sdm_fp: "Family Preservation" | "InfoShare · 380 rows"] {
      style: @ProductCard, icon: "BigQuery",
      description: "infoshare_family_preservation_clients, groups, groupclients"
    }
    [sdm_yj: "Youth Justice" | "KIMS / CNI · 320 rows"] {
      style: @ProductCard, icon: "BigQuery",
      description: "YJ_YO_CDM_Data, yj_new_clients_kims, yj_address_mapping"
    }
    [sdm_gnaf: "NSW GNAF Spine" | "Geocoded · 260 PIDs"] {
      style: @ProductCard, icon: "MapsGeospatial",
      description: "gnaf_address_materialised_view & GNAF_address_view with standardize_address UDF"
    }
  }

  Zone @Col2_Hybrid {
    area: "hybrid"
    title: "2. Hybrid Match Engine"
    subtitle: "Stages 10–40 · Bipartite + RRF"
    style: @HybridZone
    layout: column, gap: 18, align: center, justify: center

    [hyb_bip: "Bipartite IDF Graph" | "SLK-581 · CNI · NDIS · Hub Guard"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Stage 10-20: Extracts 5,143 identifier links across 2,754 nodes with log(N/df) IDF rarity & Crisis Refuge hub down-weighting"
    }
    [hyb_vec: "Gemini Platform Embed" | "AI.EMBED + VECTOR_SEARCH"] {
      style: @ProductCard, icon: "Gemini",
      description: "Stage 30: Autonomous AI.EMBED (text-embedding-005, 768-d) + COSINE Top-K VECTOR_SEARCH"
    }
    [hyb_rrf: "RRF + Kinship Scorer" | "Reciprocal Rank Fusion (k=60)"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Stage 40: Combines Lexical/Phonetic + Vector Rank + 2-Hop Shared Kinship & Twin SLK-581 Guard into 3 tiers"
    }
  }

  Zone @Col3_Adjudicator {
    area: "adjudicator"
    title: "3. Gemini Adjudicator"
    subtitle: "Stages 50–60 · Audit & Graph CC"
    style: @AdjudicatorZone
    layout: column, gap: 18, align: center, justify: center

    [adj_cc: "Two-Pass Clustering" | "Connected Components + Guard"] {
      style: @HeroCard, icon: "Dataflow",
      description: "Stage 60: Pass-1 Connected Components + Pass-2 Contradiction & Twin Guard -> 599 Golden Persons (0 hairballs)"
    }
    [adj_ledger: "Immutable Audit Ledger" | "Verdict · Evidence · Tokens"] {
      style: @ProductCard, icon: "CloudAuditLogs",
      description: "person_match_adjudications: Append-only ledger recording rationale, decisive_evidence, prompt_version & token counts"
    }
    [adj_llm: "Gemini Platform Judge" | "AI.GENERATE · 391 Grey-Zone"] {
      style: @HeroCard, icon: "Gemini",
      description: "Stage 50: Calls gemini-2.5-flash on Gemini Platform for 391 grey-zone pairs with structured schema enforcement"
    }
  }

  Zone @Col4_TDM {
    area: "tdm"
    title: "4. Target Model & Graph"
    subtitle: "Stages 60–80 · TDM & Catalog"
    style: @TdmZone
    layout: column, gap: 18, align: center, justify: center

    [tdm_tables: "9 Mastered TDM Tables" | "599 Golden Persons · F1 0.997"] {
      style: @HeroCard, icon: "BigQuery",
      description: "party (681), person (599), person_name (1,623), address_location (260), address_relation (630), party_relationship (593), person_source_linkage (1,150), person_protection_event (45), person_identity_instrument (1,517)"
    }
    [tdm_graph: "Property Graph & TVF" | "dcj_person_graph · fn_person_match"] {
      style: @HeroCard, icon: "BigQuery",
      description: "Stage 70-80: Unified ISO GQL Property Graph (8 Node labels, 9 Edge labels) + Real-time fn_person_match TVF"
    }
    [tdm_catalog: "Knowledge Catalog" | "118 Glossary Terms & Links"] {
      style: @ProductCard, icon: "Dataplex",
      description: "BigQuery Knowledge Catalog Business Glossary (dcj_person_cdm_glossary) with 6 Categories, 118 Terms & Column EntryLinks"
    }
  }
}

[sdm_cp] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "ChildStory", color: $GcpBlue }
[sdm_fp] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "InfoShare", color: $GcpBlue }
[sdm_yj] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "KIMS / CNI", color: $GcpBlue }
[sdm_gnaf] --> [hyb_bip] { sourceAnchor: "right", targetAnchor: "left", label: "GNAF PIDs", color: $GcpBlue }

[hyb_bip] --> [hyb_vec] { sourceAnchor: "bottom", targetAnchor: "top", label: "1,150 Profiles", color: $GcpGreen }
[hyb_vec] --> [hyb_rrf] { sourceAnchor: "bottom", targetAnchor: "top", label: "Cosine Top-K", color: $GcpGreen }

[hyb_rrf] --> [adj_llm] { sourceAnchor: "right", targetAnchor: "left", label: "391 Grey-Zone", color: $AmberGold }
[hyb_rrf] --> [adj_cc] { sourceAnchor: "right", targetAnchor: "left", label: "405 Auto-Match", color: $GcpGreen }

[adj_llm] --> [adj_ledger] { curve: "step",  sourceAnchor: "top", targetAnchor: "bottom", label: "JSON Verdicts", color: $AmberGold }
[adj_ledger] --> [adj_cc] { curve: "step",  sourceAnchor: "top", targetAnchor: "bottom", label: "Audited Edges", color: $AmberGold }

[adj_cc] --> [tdm_tables] { sourceAnchor: "right", targetAnchor: "left", label: "599 Golden IDs", color: $PurpleAccent }
[tdm_tables] --> [tdm_graph] { sourceAnchor: "bottom", targetAnchor: "top", label: "8 Nodes · 9 Edges", color: $PurpleAccent }
[tdm_graph] --> [tdm_catalog] { sourceAnchor: "bottom", targetAnchor: "top", label: "118 Terms", color: $PurpleAccent }

animation "Main flow" {
  loop: false
  step 1: [sdm_cp] -> [hyb_bip] { packet: "1. Ingest SDM Sources", duration: "1.0s" }
  step 2: [hyb_bip] -> [hyb_vec] { packet: "2. AI.EMBED Profiles", duration: "1.0s" }
  step 3: [hyb_vec] -> [hyb_rrf] { packet: "3. Hybrid RRF + Kinship", duration: "1.0s" }
  step 4: [hyb_rrf] -> [adj_llm] { packet: "4. 391 Grey-Zone Pairs", duration: "1.0s" }
  step 5: [adj_llm] -> [adj_ledger] { packet: "5. Audit Verdict & Tokens", duration: "1.0s" }
  step 6: [adj_ledger] -> [adj_cc] { packet: "6. Two-Pass Graph CC", duration: "1.0s" }
  step 7: [adj_cc] -> [tdm_tables] { packet: "7. Populate 9 TDM Tables", duration: "1.0s" }
  step 8: [tdm_tables] -> [tdm_graph] { packet: "8. Build Property Graph", duration: "1.0s" }
  step 9: [tdm_graph] -> [tdm_catalog] { packet: "9. Attach Glossary Terms", duration: "1.0s" }
}
